# systemd EnvironmentFile syntax; no `export`, substitutions, or shell commands.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CROSSDO_DBOP_URL=http://127.0.0.1:1900
CROSSDO_IAM_URL=http://127.0.0.1:10089
CROSSDO_SERVICE_NAME=CROSSDO_WEB
CROSSDO_SERVICE_PASSWORD=CHANGE_ME_WEB_SERVICE_PASSWORD
CROSSDO_SESSION_TTL=PT2H
CROSSDO_UPLOAD_DIR=/var/lib/crossdo/uploads

# Required only with the supplied loopback-only Java + Nginx topology.
# Nginx overwrites X-Forwarded-For. Only loopback proxies are trusted.
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES='127[.]0[.]0[.]1|::1'

# Keep disabled until a real adapter is configured. Development returns OTPs
# and permits simulated money; it is suitable only for isolated local tests.
CROSSDO_SMS_MODE=disabled
CROSSDO_SMS_GATEWAY_URL=
CROSSDO_SMS_GATEWAY_KEY=
CROSSDO_PAYMENT_MODE=disabled
CROSSDO_PAYMENT_GATEWAY_URL=
CROSSDO_PAYMENT_GATEWAY_KEY=
CROSSDO_PAYMENT_WEBHOOK_SECRET=
