# Copy to /etc/crossdo/dbop.yaml; replace CHANGE_ME values before starting.
# Flat YAML scalar values only. These are not environment-variable expressions.
server_port: "1900"
log_file: "/var/log/crossdo/dbop.log"
log_config: "/etc/crossdo/dbop-zlog.conf"
database_ip: "127.0.0.1"
database_port: "3306"
database_privilege_user: "crossdo_app"
database_privilege_password: "CHANGE_ME_DATABASE_PASSWORD"
user_database_name: "crossdo"
database_pool_size: "3"
redis_server: "127.0.0.1"
redis_port: "6379"
redis_password: "CHANGE_ME_REDIS_PASSWORD"
redis_pool_size: "3"
