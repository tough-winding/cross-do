-- Run against crossdo after schema import. Use a new independent random secret.
-- Java CROSSDO_SERVICE_PASSWORD must match this value exactly.
INSERT INTO service(service_name,service_passwd)
VALUES ('CROSSDO_WEB','CHANGE_ME_WEB_SERVICE_PASSWORD');
-- IAM generates its own IAM_SERVICE token in Redis at startup. It does not
-- require a default password or an IAM_SERVICE service-table row.
